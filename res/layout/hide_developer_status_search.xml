<!-- Vmax -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/search_bar_margin"
    android:paddingVertical="8dp">

    <SearchView
        android:id="@+id/hide_developer_status_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_bar_height"
        android:background="@drawable/hide_developer_status_search_background"
        android:iconifiedByDefault="false"
        android:imeOptions="actionSearch|flagNoExtractUi"
        android:queryBackground="@android:color/transparent"
        android:queryHint="@string/hide_developer_status_search_hint" />
</FrameLayout>
