<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/gamma_correction_title">

    <com.android.settings.widget.SettingsMainSwitchPreference
        android:key="gamma_correction_enabled"
        android:title="@string/gamma_correction_main_switch_title"
        android:persistent="false"
        settings:controller="com.android.settings.display.GammaCorrectionPreferenceController"/>

    <Preference
        android:key="gamma_calibration"
        android:title="@string/gamma_calibration_title"
        android:fragment="com.android.settings.display.GammaCalibrationSettings" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="gamma_calibration_grid"
        android:layout="@layout/gamma_calibration_grid"
        android:selectable="false"
        settings:searchable="false"/>

</PreferenceScreen>
